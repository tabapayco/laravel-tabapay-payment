{
    "name": "tabapay/payment",
    "description": "A flexible payment package for TabaPay integration in Laravel",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "laravel/framework": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Tabapay\\Payment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tabapay\\Payment\\PaymentServiceProvider"
            ],
            "aliases": {
                "Payment": "Tabapay\\Payment\\Facades\\PaymentFacade"
            }
        }
    }
}